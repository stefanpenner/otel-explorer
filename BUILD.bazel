load("@bazel_env.bzl", "bazel_env")
load("@gazelle//:def.bzl", "gazelle")

# gazelle:prefix github.com/stefanpenner/otel-explorer
gazelle(name = "gazelle")

bazel_env(
    name = "bazel_env",
    tools = {
        "go": "@rules_go//go",
    },
)

# Convenience alias so `bazel run //:ote` works from the repo root.
alias(
    name = "ote",
    actual = "//cmd/ote",
)

# Decision-core codegen (TLA+ → Go via hermetic //tools/specgen).
#   bazel test  //tools/decision:up_to_date
#   bazel run   //tools/decision:update
alias(
    name = "decision_cores_up_to_date",
    actual = "//tools/decision:up_to_date",
)

alias(
    name = "update_decision_cores",
    actual = "//tools/decision:update",
)
